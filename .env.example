# ─────────────────────────────────────────────────────────────
# Client-visible. Safe to expose — anon key is RLS-constrained.
#
# The URL is filled in because it ships in the client bundle anyway and
# identifies the project without granting anything. The anon key is NOT here:
# it belongs in your own .env.local, which is gitignored. Nothing protects this
# project until the RLS policies in spec/03-data-model.md are applied, so do
# that before any real data goes in.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://nosifadaldhgjeyzhpao.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "on" once Google is enabled under Authentication → Providers (README, "Google
# sign-in"). Until then the button is hidden rather than failing when clicked.
NEXT_PUBLIC_AUTH_GOOGLE=

# "on" sends journal entries to the AI for a reflection. Leave it EMPTY while
# GEMINI_API_KEY is a free-tier key: Google's unpaid tier may use inputs to
# improve its products and let reviewers read them (README, "Getting the keys").
NEXT_PUBLIC_AI_REFLECT=

# ─────────────────────────────────────────────────────────────
# SERVER ONLY. Never prefix these with NEXT_PUBLIC_ and never
# import them outside app/api/. See spec/04-ai-agents.md (API-1).
# ─────────────────────────────────────────────────────────────

# Bypasses RLS. Used only by security-definer paths and the seeder.
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio → Get API key. Free tier: imports only (see above).
# Without it, every import gets a curated fallback action instead.
GEMINI_API_KEY=

# Shared secret for the hourly challenge seeder route, so it cannot
# be triggered by anyone who finds the URL.
CRON_SECRET=
