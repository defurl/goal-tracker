# ─────────────────────────────────────────────────────────────
# Client-visible. Safe to expose — anon key is RLS-constrained.
#
# The URL is filled in because it ships in the client bundle anyway and
# identifies the project without granting anything. The anon key is NOT here:
# it belongs in your own .env.local, which is gitignored. Nothing protects this
# project until the RLS policies in spec/02-data-model.md are applied, so do
# that before any real data goes in.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://nosifadaldhgjeyzhpao.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────
# SERVER ONLY. Never prefix these with NEXT_PUBLIC_ and never
# import them outside app/api/. See spec/04-ai-agents.md (API-1).
# ─────────────────────────────────────────────────────────────

# Bypasses RLS. Used only by security-definer paths and the seeder.
SUPABASE_SERVICE_ROLE_KEY=

# Must have a $20/day hard spend cap set in the OpenAI dashboard.
# See spec/04-ai-agents.md §6 (COST-1).
OPENAI_API_KEY=

# Shared secret for the hourly challenge seeder route, so it cannot
# be triggered by anyone who finds the URL.
CRON_SECRET=
